-- ============================================================
-- 構造: ALTER TABLE〜最後の GRANT まで完全なSQLファイル
-- 変更点:
--   - recipes に recipe_proc カラムを追加（レシピ全体の製作方法）
--   - recipe_mats の mat_proc カラムを廃止（削除はせず無視）
--   - insert_recipe_full / update_recipe_full で recipe_proc を保存
-- ============================================================

-- ============================================================
-- 1. スキーマ変更（冪等）
-- ============================================================
ALTER TABLE recipes
  ADD COLUMN IF NOT EXISTS skill_level TEXT DEFAULT NULL;

ALTER TABLE recipes
  ADD COLUMN IF NOT EXISTS skill_level_num INT DEFAULT NULL;

-- ★ レシピ全体の製作方法（新規追加）
ALTER TABLE recipes
  ADD COLUMN IF NOT EXISTS recipe_proc TEXT DEFAULT NULL;

-- ============================================================
-- 2. recipe_mats / recipe_step_mats の代替品カラム（冪等）
-- ============================================================
ALTER TABLE recipe_mats
  ADD COLUMN IF NOT EXISTS alt_connector TEXT DEFAULT 'あるいは';
ALTER TABLE recipe_mats
  ADD COLUMN IF NOT EXISTS parent_mat_id BIGINT
    REFERENCES recipe_mats(id) ON DELETE CASCADE;

ALTER TABLE recipe_step_mats
  ADD COLUMN IF NOT EXISTS alt_connector  TEXT   DEFAULT 'あるいは',
  ADD COLUMN IF NOT EXISTS parent_mat_id  BIGINT REFERENCES recipe_step_mats(id) ON DELETE CASCADE;


-- ============================================================
-- 3. insert_recipe_full（recipe_proc 対応版）
-- ============================================================
CREATE OR REPLACE FUNCTION insert_recipe_full(payload JSONB)
RETURNS BIGINT
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_sheet_id      BIGINT;
  v_recipe_id     BIGINT;
  v_subgroup_id   BIGINT;
  v_step_id       BIGINT;
  v_mat_id        BIGINT;
  v_step_mat_id   BIGINT;
  v_city          JSONB;
  v_mat           JSONB;
  v_alt           JSONB;
  v_subgroup      JSONB;
  v_step          JSONB;
  v_step_mat      JSONB;
  v_step_mat_alt  JSONB;
  v_i             INT;
  v_j             INT;
  v_k             INT;
  v_l             INT;
  v_m             INT;
BEGIN
  SELECT id INTO v_sheet_id
    FROM sheets
   WHERE name = (payload->>'sheet_name');
  IF v_sheet_id IS NULL THEN
    RAISE EXCEPTION 'Sheet not found: %', payload->>'sheet_name';
  END IF;

  INSERT INTO recipes(sheet_id, name, category, image_url, effect,
                      skill_level, skill_level_num,
                      imperial_rank, imperial_qty_min, imperial_qty_max,
                      recipe_proc)
  VALUES (
    v_sheet_id,
    payload->>'name',
    payload->>'category',
    payload->>'image_url',
    payload->>'effect',
    payload->>'skill_level',
    (payload->>'skill_level_num')::INT,
    payload->>'imperial_rank',
    (payload->>'imperial_qty_min')::INT,
    (payload->>'imperial_qty_max')::INT,
    payload->>'recipe_proc'
  )
  RETURNING id INTO v_recipe_id;

  -- cities
  v_i := 0;
  FOR v_city IN SELECT * FROM jsonb_array_elements(COALESCE(payload->'cities', '[]'))
  LOOP
    INSERT INTO recipe_cities(recipe_id, sort_order, city_name, city_level)
    VALUES (v_recipe_id, v_i, v_city->>'name', v_city->>'level');
    v_i := v_i + 1;
  END LOOP;

  -- recipe_mats（基本材料 + alts）
  v_i := 0;
  FOR v_mat IN SELECT * FROM jsonb_array_elements(COALESCE(payload->'mats', '[]'))
  LOOP
    INSERT INTO recipe_mats(recipe_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
    VALUES (v_recipe_id, v_i, v_mat->>'name', v_mat->>'qty', NULL, NULL)
    RETURNING id INTO v_mat_id;

    v_l := 0;
    FOR v_alt IN SELECT * FROM jsonb_array_elements(COALESCE(v_mat->'alts', '[]'))
    LOOP
      INSERT INTO recipe_mats(recipe_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
      VALUES (v_recipe_id, v_l, v_alt->>'name', v_alt->>'qty', v_mat_id,
              COALESCE(v_alt->>'connector', 'あるいは'));
      v_l := v_l + 1;
    END LOOP;
    v_i := v_i + 1;
  END LOOP;

  -- subgroups
  v_i := 0;
  FOR v_subgroup IN SELECT * FROM jsonb_array_elements(COALESCE(payload->'subgroups', '[]'))
  LOOP
    INSERT INTO recipe_subgroups(recipe_id, sort_order, parent)
    VALUES (v_recipe_id, v_i, v_subgroup->>'parent')
    RETURNING id INTO v_subgroup_id;

    v_j := 0;
    FOR v_step IN SELECT * FROM jsonb_array_elements(COALESCE(v_subgroup->'steps', '[]'))
    LOOP
      INSERT INTO recipe_steps(subgroup_id, sort_order, connector, proc, result_name, result_qty)
      VALUES (v_subgroup_id, v_j, v_step->>'connector', v_step->>'proc',
              v_step->>'result_name', v_step->>'result_qty')
      RETURNING id INTO v_step_id;

      v_k := 0;
      FOR v_step_mat IN SELECT * FROM jsonb_array_elements(COALESCE(v_step->'mats', '[]'))
      LOOP
        INSERT INTO recipe_step_mats(step_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
        VALUES (v_step_id, v_k, v_step_mat->>'name', v_step_mat->>'qty', NULL, NULL)
        RETURNING id INTO v_step_mat_id;

        v_m := 0;
        FOR v_step_mat_alt IN SELECT * FROM jsonb_array_elements(COALESCE(v_step_mat->'alts', '[]'))
        LOOP
          INSERT INTO recipe_step_mats(step_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
          VALUES (v_step_id, v_m, v_step_mat_alt->>'name', v_step_mat_alt->>'qty', v_step_mat_id,
                  COALESCE(v_step_mat_alt->>'connector', 'あるいは'));
          v_m := v_m + 1;
        END LOOP;

        v_k := v_k + 1;
      END LOOP;
      v_j := v_j + 1;
    END LOOP;
    v_i := v_i + 1;
  END LOOP;

  RETURN v_recipe_id;
END;
$$;


-- ============================================================
-- 4. update_recipe_full（recipe_proc 対応版）
-- ============================================================
CREATE OR REPLACE FUNCTION update_recipe_full(p_recipe_id BIGINT, payload JSONB)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_sheet_id      BIGINT;
  v_subgroup_id   BIGINT;
  v_step_id       BIGINT;
  v_mat_id        BIGINT;
  v_step_mat_id   BIGINT;
  v_city          JSONB;
  v_mat           JSONB;
  v_alt           JSONB;
  v_subgroup      JSONB;
  v_step          JSONB;
  v_step_mat      JSONB;
  v_step_mat_alt  JSONB;
  v_i             INT;
  v_j             INT;
  v_k             INT;
  v_l             INT;
  v_m             INT;
BEGIN
  SELECT id INTO v_sheet_id
    FROM sheets
   WHERE name = (payload->>'sheet_name');
  IF v_sheet_id IS NULL THEN
    RAISE EXCEPTION 'Sheet not found: %', payload->>'sheet_name';
  END IF;

  UPDATE recipes
     SET sheet_id         = v_sheet_id,
         name             = payload->>'name',
         category         = payload->>'category',
         image_url        = payload->>'image_url',
         effect           = payload->>'effect',
         skill_level      = payload->>'skill_level',
         skill_level_num  = (payload->>'skill_level_num')::INT,
         imperial_rank    = payload->>'imperial_rank',
         imperial_qty_min = (payload->>'imperial_qty_min')::INT,
         imperial_qty_max = (payload->>'imperial_qty_max')::INT,
         recipe_proc      = payload->>'recipe_proc'
   WHERE id = p_recipe_id;

  -- cities
  DELETE FROM recipe_cities WHERE recipe_id = p_recipe_id;
  v_i := 0;
  FOR v_city IN SELECT * FROM jsonb_array_elements(COALESCE(payload->'cities', '[]'))
  LOOP
    INSERT INTO recipe_cities(recipe_id, sort_order, city_name, city_level)
    VALUES (p_recipe_id, v_i, v_city->>'name', v_city->>'level');
    v_i := v_i + 1;
  END LOOP;

  -- recipe_mats
  DELETE FROM recipe_mats WHERE recipe_id = p_recipe_id AND parent_mat_id IS NULL;
  v_i := 0;
  FOR v_mat IN SELECT * FROM jsonb_array_elements(COALESCE(payload->'mats', '[]'))
  LOOP
    INSERT INTO recipe_mats(recipe_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
    VALUES (p_recipe_id, v_i, v_mat->>'name', v_mat->>'qty', NULL, NULL)
    RETURNING id INTO v_mat_id;

    v_l := 0;
    FOR v_alt IN SELECT * FROM jsonb_array_elements(COALESCE(v_mat->'alts', '[]'))
    LOOP
      INSERT INTO recipe_mats(recipe_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
      VALUES (p_recipe_id, v_l, v_alt->>'name', v_alt->>'qty', v_mat_id,
              COALESCE(v_alt->>'connector', 'あるいは'));
      v_l := v_l + 1;
    END LOOP;
    v_i := v_i + 1;
  END LOOP;

  -- subgroups（DELETE CASCADE で recipe_steps / recipe_step_mats も連鎖削除）
  DELETE FROM recipe_subgroups WHERE recipe_id = p_recipe_id;
  v_i := 0;
  FOR v_subgroup IN SELECT * FROM jsonb_array_elements(COALESCE(payload->'subgroups', '[]'))
  LOOP
    INSERT INTO recipe_subgroups(recipe_id, sort_order, parent)
    VALUES (p_recipe_id, v_i, v_subgroup->>'parent')
    RETURNING id INTO v_subgroup_id;

    v_j := 0;
    FOR v_step IN SELECT * FROM jsonb_array_elements(COALESCE(v_subgroup->'steps', '[]'))
    LOOP
      INSERT INTO recipe_steps(subgroup_id, sort_order, connector, proc, result_name, result_qty)
      VALUES (v_subgroup_id, v_j, v_step->>'connector', v_step->>'proc',
              v_step->>'result_name', v_step->>'result_qty')
      RETURNING id INTO v_step_id;

      v_k := 0;
      FOR v_step_mat IN SELECT * FROM jsonb_array_elements(COALESCE(v_step->'mats', '[]'))
      LOOP
        INSERT INTO recipe_step_mats(step_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
        VALUES (v_step_id, v_k, v_step_mat->>'name', v_step_mat->>'qty', NULL, NULL)
        RETURNING id INTO v_step_mat_id;

        v_m := 0;
        FOR v_step_mat_alt IN SELECT * FROM jsonb_array_elements(COALESCE(v_step_mat->'alts', '[]'))
        LOOP
          INSERT INTO recipe_step_mats(step_id, sort_order, mat_name, mat_qty, parent_mat_id, alt_connector)
          VALUES (v_step_id, v_m, v_step_mat_alt->>'name', v_step_mat_alt->>'qty', v_step_mat_id,
                  COALESCE(v_step_mat_alt->>'connector', 'あるいは'));
          v_m := v_m + 1;
        END LOOP;

        v_k := v_k + 1;
      END LOOP;
      v_j := v_j + 1;
    END LOOP;
    v_i := v_i + 1;
  END LOOP;
END;
$$;


-- ============================================================
-- 5. RLS 有効化
-- ============================================================
ALTER TABLE sheets            ENABLE ROW LEVEL SECURITY;
ALTER TABLE sheet_cities      ENABLE ROW LEVEL SECURITY;
ALTER TABLE recipes           ENABLE ROW LEVEL SECURITY;
ALTER TABLE recipe_cities     ENABLE ROW LEVEL SECURITY;
ALTER TABLE recipe_mats       ENABLE ROW LEVEL SECURITY;
ALTER TABLE recipe_subgroups  ENABLE ROW LEVEL SECURITY;
ALTER TABLE recipe_steps      ENABLE ROW LEVEL SECURITY;
ALTER TABLE recipe_step_mats  ENABLE ROW LEVEL SECURITY;


-- ============================================================
-- 6. ポリシー（冪等）
-- ============================================================
DROP POLICY IF EXISTS "public read sheets"           ON sheets;
CREATE POLICY "public read sheets"           ON sheets            FOR SELECT TO anon USING (true);

DROP POLICY IF EXISTS "public read sheet_cities"     ON sheet_cities;
DROP POLICY IF EXISTS "auth insert sheet_cities"     ON sheet_cities;
DROP POLICY IF EXISTS "auth delete sheet_cities"     ON sheet_cities;
CREATE POLICY "public read sheet_cities"     ON sheet_cities      FOR SELECT TO anon        USING (true);
CREATE POLICY "auth insert sheet_cities"     ON sheet_cities      FOR INSERT TO authenticated WITH CHECK (true);
CREATE POLICY "auth delete sheet_cities"     ON sheet_cities      FOR DELETE TO authenticated USING (true);

DROP POLICY IF EXISTS "public read recipes"          ON recipes;
CREATE POLICY "public read recipes"          ON recipes           FOR SELECT TO anon USING (true);

DROP POLICY IF EXISTS "public read recipe_cities"    ON recipe_cities;
CREATE POLICY "public read recipe_cities"    ON recipe_cities     FOR SELECT TO anon USING (true);

DROP POLICY IF EXISTS "public read recipe_mats"      ON recipe_mats;
CREATE POLICY "public read recipe_mats"      ON recipe_mats       FOR SELECT TO anon USING (true);

DROP POLICY IF EXISTS "public read recipe_subgroups" ON recipe_subgroups;
CREATE POLICY "public read recipe_subgroups" ON recipe_subgroups  FOR SELECT TO anon USING (true);

DROP POLICY IF EXISTS "public read recipe_steps"     ON recipe_steps;
CREATE POLICY "public read recipe_steps"     ON recipe_steps      FOR SELECT TO anon USING (true);

DROP POLICY IF EXISTS "public read recipe_step_mats" ON recipe_step_mats;
CREATE POLICY "public read recipe_step_mats" ON recipe_step_mats  FOR SELECT TO anon USING (true);


-- 誰でも読める（画像表示用）
CREATE POLICY "public read recipe-images"
ON storage.objects FOR SELECT TO anon
USING (bucket_id = 'recipe-images');

-- 認証済みユーザーだけアップロード可
CREATE POLICY "auth upload recipe-images"
ON storage.objects FOR INSERT TO authenticated
WITH CHECK (bucket_id = 'recipe-images');

-- 認証済みユーザーだけ削除可
CREATE POLICY "auth delete recipe-images"
ON storage.objects FOR DELETE TO authenticated
USING (bucket_id = 'recipe-images');
